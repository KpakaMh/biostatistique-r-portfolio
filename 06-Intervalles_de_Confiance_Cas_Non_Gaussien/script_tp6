# ==============================================================================
# EXERCICE 4 : Calcul de Marge d'Erreur & Taille d'Échantillon
# ==============================================================================

# Paramètres donnés : n = 90, xbar = 4.38, sigma = 0.08
n_stud   <- 90
xbar_stud <- 4.38
sig_stud <- 0.08

# 1. IC de la moyenne à 95% et 99%
ic_95_stud <- xbar_stud + c(-1, 1) * qnorm(0.975) * (sig_stud / sqrt(n_stud))
ic_99_stud <- xbar_stud + c(-1, 1) * qnorm(0.995) * (sig_stud / sqrt(n_stud))

cat("IC 95% : [", round(ic_95_stud[1], 4), ";", round(ic_95_stud[2], 4), "]\n")
cat("IC 99% : [", round(ic_99_stud[1], 4), ";", round(ic_99_stud[2], 4), "]\n")

# 2. Calcul de la taille d'échantillon minimale (n) pour une marge d'erreur e = 0.01
e_cible <- 0.01
n_requis <- (qnorm(0.975) * sig_stud / e_cible)^2
cat("Taille d'échantillon minimale requise (n) :", ceiling(n_requis), "\n")

# 3. Évaluation du niveau de confiance pour une marge fixée e = 0.01 avec n = 80
n_reduit <- 80
confiance_obtenue <- 1 - 2 * pnorm(-e_cible / sig_stud * sqrt(n_reduit))
cat("Niveau de confiance obtenu pour n = 80 :", round(confiance_obtenue * 100, 2), "%\n")


# ==============================================================================
# EXERCICE 5 : Intervalle de Confiance pour la Variance et l'Écart-Type
# ==============================================================================

# Paramètres : n = 100, xbar = 18.4, s = 0.32
n_var  <- 100
Sp_var <- 0.32
alpha  <- 0.05

# Quantiles de la loi du Chi-deux à (n-1) degrés de liberté
z1 <- qchisq(1 - alpha / 2, df = n_var - 1)
z2 <- qchisq(alpha / 2,     df = n_var - 1)

# Bornes de l'IC pour l'écart-type sigma
borne_inf_sigma <- Sp_var * sqrt((n_var - 1) / z1)
borne_sup_sigma <- Sp_var * sqrt((n_var - 1) / z2)

cat("IC 95% de l'écart-type sigma : [", round(borne_inf_sigma, 4), ";", round(borne_sup_sigma, 4), "]\n")
